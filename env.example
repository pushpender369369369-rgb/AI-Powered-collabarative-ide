# Required: 32+ random chars. Signs share links. Changing it invalidates ALL existing links.
SECRET=change-me-to-a-long-random-string-32chars
# AI (optional; pick one). AI_PROVIDER defaults to openai if OPENAI_API_KEY is set.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# AI_MODEL=gpt-4o
# COMPLETE_MODEL=gpt-4o-mini
# Production: your public origin, e.g. https://ide.example.com (enables WebSocket origin check)
# ALLOWED_ORIGIN=
# MAX_PEERS=25
# AI_RATE=30
PORT=3000
DATA_DIR=./data
